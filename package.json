{
  "name": "friends-meet",
  "version": "1.0.0",
  "description": "局域网桌面宠物聊天",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "author": "friends",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.friends.meet",
    "productName": "好友见面",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "disableAsarIntegrity": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "好友见面-${version}.exe"
    }
  }
}
